#!/bin/sh

echo "🔍 Running pre-commit hook to check the code looks good... 🔍"

# Load NVM if available (useful for managing Node.js versions)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Ensure `pnpm` is available
echo "Checking if pnpm is available..."
if ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ pnpm not found! Please ensure pnpm is installed and available in PATH."
    exit 1
fi

# Quick dependency check to avoid noisy type errors when deps are missing
MISSING_DEPS=false
MISSING_LIST=""

# If node_modules is missing, we can safely assume deps aren't installed
if [ ! -d node_modules ]; then
  MISSING_DEPS=true
  MISSING_LIST="(node_modules not found)"
else
  # Minimal set of SDK packages that commonly trigger type errors when missing
  DEPS_TO_CHECK="@ai-sdk/openai @ai-sdk/anthropic @ai-sdk/amazon-bedrock @ai-sdk/cohere @ai-sdk/google @ai-sdk/mistral @openrouter/ai-sdk-provider"
  for PKG in $DEPS_TO_CHECK; do
    PKG_PATH="node_modules/$(echo "$PKG" | sed 's|@|@|;s|/|/|')/package.json"
    if [ ! -f "$PKG_PATH" ]; then
      MISSING_DEPS=true
      if [ -z "$MISSING_LIST" ]; then
        MISSING_LIST="$PKG"
      else
        MISSING_LIST="$MISSING_LIST, $PKG"
      fi
    fi
  done
fi

if [ "$MISSING_DEPS" = true ]; then
  echo "⚠️  Skipping typecheck/lint because dependencies are missing: $MISSING_LIST"
  echo "👉 Quick fix: run 'pnpm install' and re-commit."
  echo "🛟 Urgent bypass: 'git commit -n' (or '--no-verify') to skip hooks for this commit."
  exit 0
fi

# Run typecheck
echo "Running typecheck..."
if ! pnpm typecheck; then
    echo "❌ Type checking failed!"
    echo "👉 Try: 'pnpm install' (if missing modules), then 'pnpm typecheck' to verify locally."
    echo "🛟 Urgent bypass: 'git commit -n' (or '--no-verify') to skip hooks for this commit."
    exit 1
fi

# Run lint
echo "Running lint..."
if ! pnpm lint; then
    echo "❌ Linting failed!"
    echo "👉 Quick fix: 'pnpm lint:fix' and then 'pnpm lint' to verify."
    echo "🛟 Urgent bypass: 'git commit -n' (or '--no-verify') to skip hooks for this commit."
    exit 1
fi

echo "👍 All checks passed! Committing changes..."
